rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // For rules scoped to a household's subcollections, checking membership
    // requires reading the parent household doc — that's a normal, supported
    // cross-document get(). It's different from the top-level households
    // read rule below, which must check `resource.data` directly rather than
    // self-referencing get(), since list/query requests evaluate per-candidate
    // document and a self-get() there is unreliable.
    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Joining via an invite link: the household ID itself is the secret (an
    // unguessable Firestore auto-ID never exposed by `list`), so anyone who
    // holds the link may add themselves — and only themselves — as a member.
    function isSelfJoin() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      return isSignedIn() &&
        !(request.auth.uid in before) &&
        (request.auth.uid in after) &&
        after.size() == before.size() + 1 &&
        after.hasAll(before) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.ratingMode == resource.data.ratingMode &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /households/{householdId} {
      // A specific household can be fetched by anyone signed in (needed to
      // preview it from an invite link before joining); `list` stays
      // membership-only so households can't be enumerated/browsed.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Creation: the creator must include themselves as a member.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      // Updates: existing members can do anything; non-members may only self-join.
      allow update: if isSignedIn() && (request.auth.uid in resource.data.memberIds || isSelfJoin());
      allow delete: if false;

      match /members/{userId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdMember(householdId) && request.auth.uid == userId;
      }

      match /titles/{titleId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && request.resource.data.addedBy == request.auth.uid;
        allow update, delete: if isHouseholdMember(householdId);

        match /ratings/{ratingId} {
          allow read: if isHouseholdMember(householdId);
          // The doc ID is either 'shared' (anyone in the household can update
          // the single household rating) or a member's own uid (only they
          // can write their individual rating).
          allow write: if isHouseholdMember(householdId) &&
            (ratingId == 'shared' || ratingId == request.auth.uid);
        }
      }

      match /tags/{tagId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdMember(householdId);
      }
    }
  }
}
