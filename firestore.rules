rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // For rules scoped to a household's subcollections, checking membership
    // requires reading the parent household doc — that's a normal, supported
    // cross-document get(). It's different from the top-level households
    // read rule below, which must check `resource.data` directly rather than
    // self-referencing get(), since list/query requests evaluate per-candidate
    // document and a self-get() there is unreliable.
    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    match /households/{householdId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Creation: the creator must include themselves as a member.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      // Updates: only existing members, and only members already in the doc may add/remove members.
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow delete: if false;

      match /members/{userId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdMember(householdId) && request.auth.uid == userId;
      }

      match /titles/{titleId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && request.resource.data.addedBy == request.auth.uid;
        allow update, delete: if isHouseholdMember(householdId);

        match /ratings/{ratingId} {
          allow read: if isHouseholdMember(householdId);
          allow write: if isHouseholdMember(householdId);
        }
      }

      match /tags/{tagId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdMember(householdId);
      }
    }
  }
}
